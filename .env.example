# Multi-device sync is optional. Leave these unset and Notework runs
# local-only: no account, no network, everything in this browser.
#
# To turn sync on, create a Supabase project and paste its Project URL and
# publishable key (Project Settings -> API). Then run
# src/data/sync/schema.sql in the project's SQL editor.
# See README.md for the full walkthrough.
#
# The publishable key is safe to ship in the browser and safe to commit to a
# private repo. NEVER put the *secret* key here -- it bypasses every security
# rule in the database.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
